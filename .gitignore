# local secrets (values injected into staged output at build time)
secrets.yaml

# backup
backup/*
!backup/.keep

# cache (transient scratch, e.g. claude-fork launchers)
cache/*
!cache/.keep

# build
stage/*

# ignore any contents within local directory
src/configs/local/*
!src/configs/local/.keep
src/configs/local/.config/*
!src/configs/local/.config/.keep
src/utils/local/*
!src/utils/local/.keep
src/cronjobs/local/*
!src/cronjobs/local/.keep
src/systemd/local/*
!src/systemd/local/.keep

# sensitive ranger files
src/configs/shared/ranger/history
src/configs/shared/ranger/bookmarks

# compiled files
*.pyc

# any node modules
*node_modules
*node_modules/*

.vscode

admin/config/**/*
!admin/config/template/*
!admin/config/.gitkeep

**/ansible/vault/**/*

**/.venv*

~

# HA: real network->streaming-app map reveals household subscriptions.
# Only the .example scaffold is tracked; the live file stays on the HA host.
src/configs/local-ha-raspbian/Projects/home-assistant/config/custom_templates/streaming_apps.jinja
