# Copy this file to `secrets.yaml` (gitignored) on each host and fill in real values.
# At `make stage`, each "KEY: value" line replaces the matching <KEY> placeholder in
# staged files. This keeps secrets out of the tracked source, which only contains <KEY>.
#
# Example: the Home Assistant MCP url in .codex/config.toml is stored as
#   url = "http://192.168.1.243:8086/<HA_MCP_SECRET>"
# and the real path segment is injected from here at build time.
HA_MCP_SECRET: your-home-assistant-mcp-path
