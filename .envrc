# vault layers (src/*/*-vault) are git-crypt encrypted; nudge when setup is pending

vault_file=$(find src/*/*-vault -type f ! -name .keep -print -quit 2>/dev/null)
if [ -n "$vault_file" ] && head -c 10 "$vault_file" | LC_ALL=C grep -qa GITCRYPT; then
	log_status "vault layers are locked: git-crypt unlock ~/.config/git-crypt/workflow.key"
fi

if [ -n "$(find src/*/local -mindepth 1 ! -name .keep ! -name .gitkeep -print -quit 2>/dev/null)" ]; then
	log_status "src/*/local has unvaulted files: run 'make migrate_vault'"
fi
