{
  "mcpServers": {
    "ha-mcp": {
      "type": "http",
      "url": "http://192.168.1.243:8086/<HA_MCP_SECRET>"
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.12", "blender-mcp"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-managed"
      }
    },
    "freecad": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.12", "freecad-mcp"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-managed"
      }
    },
    "qgis": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "/usr/local/src/qgis-mcp-patched",
        "qgis-mcp-server"
      ],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-managed",
        "QGIS_MCP_TOOL_MODE": "compound"
      }
    }
  }
}
